# Reverse proxy del VPS (COST-01): Nginx, no Caddy. Solo escucha en la IP de Tailscale
# (el publish de compose.yml lo ata a ${TAILSCALE_IP}); el TLS es el certificado de
# `tailscale cert`, montado en /etc/nginx/tls. La imagen oficial sustituye ${VAR} al arrancar.

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Cualquier Host que no sea el del tailnet: se cierra sin respuesta.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${TS_HOSTNAME};

    ssl_certificate     /etc/nginx/tls/${TS_HOSTNAME}.crt;
    ssl_certificate_key /etc/nginx/tls/${TS_HOSTNAME}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # Uptime Kuma (panel + websockets).
    location / {
        proxy_pass         http://uptime-kuma:3001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto https;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
