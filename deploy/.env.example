# Nombres de las variables del stack del VPS (COST-01). El .env real vive en
# /opt/csfinance/.env con chmod 600 y NUNCA entra en el repo. Valores: vacíos a propósito.
# Generar contraseñas con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Supabase (la misma service_role que Render; solo vive en Render y en este VPS)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Fuentes
STEAM_WEB_API_KEY=          # clave de la Web API de Valve (NO es STEAM_API_KEY de steamwebapi)
CSFLOAT_API_KEY=
WAXPEER_API_KEY=

# Servicios internos
VALKEY_PASSWORD=
PG_PASSWORD=                # superusuario postgres: solo initdb y backups
PG_WORKER_PASSWORD=         # rol worker: el que usa el worker
PG_TUNE_MEMORY=1GB          # memoria que timescaledb-tune asume para Postgres

# Observabilidad (COST-08): tokens de los monitores push de Uptime Kuma, separados por coma
KUMA_PUSH_TOKENS=

# Red y TLS
TAILSCALE_IP=               # `tailscale ip -4`
TS_HOSTNAME=                # nombre MagicDNS completo, p. ej. vps.tailnet-xxxx.ts.net
TLS_DIR=/opt/csfinance/tls  # donde deja los ficheros `tailscale cert`
CSFINANCE_ENV_FILE=/opt/csfinance/.env
